{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cognis.digital/schemas/startboard.schema.json",
  "title": "startboard config",
  "description": "Configuration for the startboard static start-page generator. The hand-rolled validator in src/validate.js is kept in sync with this schema; both enforce the same rules.",
  "type": "object",
  "required": ["title"],
  "additionalProperties": true,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "theme": {
      "type": "string",
      "enum": ["slate", "terminal", "amber", "ocean", "light", "dark"]
    },
    "css": {
      "type": "string",
      "description": "Extra inline CSS. Must not use @import, url(http/data), expression(), or embedded tags."
    },
    "include": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Relative paths to other config files, merged before this file's fields."
    },
    "groups": { "type": "array", "items": { "$ref": "#/definitions/group" } },
    "notes": { "type": "array", "items": { "$ref": "#/definitions/note" } },
    "status": { "type": "array", "items": { "$ref": "#/definitions/status" } },
    "boards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "icon": { "type": "string" },
          "groups": { "type": "array", "items": { "$ref": "#/definitions/group" } },
          "notes": { "type": "array", "items": { "$ref": "#/definitions/note" } },
          "status": { "type": "array", "items": { "$ref": "#/definitions/status" } }
        }
      }
    }
  },
  "definitions": {
    "link": {
      "type": "object",
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "description": { "type": "string" },
        "icon": { "type": "string", "description": "Emoji, \"glyph:name\", or inline <svg>." },
        "order": { "type": "number" }
      }
    },
    "group": {
      "type": "object",
      "required": ["title", "links"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "icon": { "type": "string" },
        "collapsed": { "type": "boolean" },
        "order": { "type": "number" },
        "links": { "type": "array", "items": { "$ref": "#/definitions/link" } }
      }
    },
    "note": {
      "type": "object",
      "required": ["title", "body"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string" },
        "markdown": { "type": "boolean", "description": "Render body as markdown-ish (default true)." },
        "order": { "type": "number" }
      }
    },
    "status": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string" },
        "type": { "type": "string", "enum": ["http", "tcp"], "default": "http" },
        "timeoutMs": { "type": "number", "exclusiveMinimum": 0 },
        "okStatuses": { "type": "array", "items": { "type": "integer" } }
      }
    }
  }
}
